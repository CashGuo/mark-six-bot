# 【推送密钥】由 WxPushTool 签发客户授权时下发，64 位十六进制字符串
WX_PUSH_SECRET=your_64_hex_secret_here

# 【多采集端 · 可选】一个接收端要接多个微信账号（多台电脑、多个微信号）时，
# 按「客户编号:密钥」配多把密钥，用逗号分隔。采集端点对点各用自己那把，
# 靠请求头 X-Wx-Cust 告诉接收端"我是哪个客户"，接收端据此挑密钥验签。
#
# 客户编号就是 WxPushTool 编译时的 -CustomerId（一个客户一把密钥），
# 密钥是该客户 license 派生的 final_secret（64 位十六进制）。
#
# 配了这个之后，WX_PUSH_SECRET 自动变成"兜底密钥"：请求头没带
# X-Wx-Cust、或带了但没配过，就用它验签（兼容现在只有一台采集端的老部署）。
#
# WX_ACCOUNT_SECRETS=C0001:你的推送密钥,C0002:另一把64位十六进制

# 【AI 模型】任何 OpenAI 兼容端点都能用，默认指向阿里云百炼的 qwen3.8-27b
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://llm-o8ou6he0iyxcz0ns.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-27b

# 思考模式：0=关闭（默认，实测 1 秒/条、格式稳定），1=开启（约 11 秒/条，且头组易错）
LLM_THINKING=0

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 【可调项】
PORT=8899
# 时间戳容差（秒），超出窗口的推送视为重放，直接拒收
WX_SKEW_SEC=300

# 仅调试用：设为 1 可跳过验签。生产环境务必不要设置
# WX_SKIP_VERIFY=1

# 配置接口只允许本机访问（1=只允许 127.0.0.1，0=放开）。默认 1，别关
# WX_CONFIG_LOCAL_ONLY=1

# 兼容旧名：只填 DEEPSEEK_API_KEY 也能跑（走 api.deepseek.com / deepseek-chat）
# DEEPSEEK_API_KEY=sk-xxxx
